#!/bin/sh
# tekdek launcher of the plugin.
#
# Runs the release binary of the plugin version, and downloads it into the
# cache on the first run. Claude Code puts this folder on PATH after the PATH
# of the user, so an installed tekdek runs first. The download needs the
# release archive and its sha256 file; without them, nothing runs.
set -eu

repository=dychen1/tekdek
plugin=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$plugin/.claude-plugin/plugin.json" | head -n 1)
[ -n "$version" ] || { echo "tekdek: the plugin manifest has no version" >&2; exit 2; }
binary="${XDG_CACHE_HOME:-$HOME/.cache}/tekdek/$version/tekdek"

if [ ! -x "$binary" ]; then
    case "$(uname -s)-$(uname -m)" in
        Darwin-arm64) target=aarch64-apple-darwin ;;
        Darwin-x86_64) target=x86_64-apple-darwin ;;
        Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
        Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-gnu ;;
        *)
            echo "tekdek: no release binary for $(uname -s) $(uname -m). Install tekdek: https://github.com/$repository#install" >&2
            exit 2
            ;;
    esac
    archive="tekdek-$target.tar.xz"
    url="https://github.com/$repository/releases/download/v$version"
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    echo "tekdek: downloading v$version for $target into $(dirname "$binary") (first run only)" >&2
    if ! curl -fsSL -o "$work/$archive" "$url/$archive" ||
        ! curl -fsSL -o "$work/$archive.sha256" "$url/$archive.sha256"; then
        # A private repository serves its releases only with credentials.
        gh release download "v$version" --repo "$repository" --dir "$work" --clobber \
            --pattern "$archive" --pattern "$archive.sha256" >&2 ||
            { echo "tekdek: cannot download v$version. Install tekdek: https://github.com/$repository#install" >&2; exit 2; }
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum <"$work/$archive")
    else
        actual=$(shasum -a 256 <"$work/$archive")
    fi
    if [ "${actual%% *}" != "$(cut -d ' ' -f 1 <"$work/$archive.sha256")" ]; then
        echo "tekdek: the checksum of $archive does not match its release" >&2
        exit 2
    fi
    tar -xJf "$work/$archive" -C "$work"
    mkdir -p "$(dirname "$binary")"
    # The rename is atomic, so a second launcher never runs a partial binary.
    mv "$work/tekdek-$target/tekdek" "$binary.$$"
    mv "$binary.$$" "$binary"
    rm -rf "$work"
    trap - EXIT
fi
exec "$binary" "$@"
